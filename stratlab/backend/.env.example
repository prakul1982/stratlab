# Copy to .env and fill in. Never commit the real .env.

# Supabase (Project settings > API). The service_role key must stay on the server.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# Zerodha Kite Connect
KITE_API_KEY=
KITE_API_SECRET=
# Optional automatic daily login (see README before enabling)
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=
KITE_AUTO_LOGIN_AT=08:00
# Restart the server after each Kite login so the live feed uses the new token
KITE_RESTART_AFTER_LOGIN=true

# Razorpay (Test Mode keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BASIC=
RAZORPAY_PLAN_PRO=
# Optional yearly plans (two months free); the Plans page offers yearly billing only when both are set
RAZORPAY_PLAN_BASIC_YEAR=
RAZORPAY_PLAN_PRO_YEAR=

# AI (idea builder, ask bar, research reads). Set one or more keys; each is optional and skipped when empty.
# Which models are used is measured every 6 hours (Admin → Services → AI); see docs/ADMIN.md for every
# provider's free limit and terms. <NAME>_MODEL=auto lets measurement pick; a model id pins one.
AI_PROVIDERS=auto                # auto = measured order; or a fixed order like: groq,gemini,mistral
AI_PROVIDERS_RESEARCH=auto       # a fixed order for research reads and long documents only
GROQ_API_KEY=                    # console.groq.com/keys: free, the fastest
GROQ_MODEL=auto
GEMINI_API_KEY=                  # aistudio.google.com/apikey: free tier, biggest context (long documents)
GEMINI_MODEL=auto
MISTRAL_API_KEY=                 # console.mistral.ai/api-keys: free "Experiment" plan
MISTRAL_MODEL=auto
CEREBRAS_API_KEY=                # cloud.cerebras.ai: free tier, very fast
CEREBRAS_MODEL=auto
SAMBANOVA_API_KEY=               # cloud.sambanova.ai/apis: free tier
SAMBANOVA_MODEL=auto
OPENROUTER_API_KEY=              # openrouter.ai/settings/keys: only models marked :free are used
OPENROUTER_MODEL=auto
CLOUDFLARE_API_TOKEN=            # dash.cloudflare.com/profile/api-tokens ("Workers AI" permission): 10,000 neurons a day free
CLOUDFLARE_ACCOUNT_ID=           # the account id shown on the Cloudflare dashboard (both are needed)
CLOUDFLARE_MODEL=auto
ZAI_API_KEY=                     # z.ai/manage-apikey/apikey-list: the GLM Flash models are free
ZAI_MODEL=auto
AI_GATEWAY_API_KEY=              # vercel.com/dashboard/ai-gateway: $5 free credit every 30 days
AI_GATEWAY_MODEL=auto
HF_TOKEN=                        # huggingface.co/settings/tokens ("Make calls to Inference Providers"): $0.10 a month free
HUGGINGFACE_MODEL=auto
GITHUB_MODELS_TOKEN=             # github.com/settings/personal-access-tokens ("Models" read): free, prototyping tier, asked late
GITHUB_MODEL=auto
NVIDIA_API_KEY=                  # build.nvidia.com/settings/api-keys: free for development only, asked late
NVIDIA_MODEL=auto
ANTHROPIC_API_KEY=               # paid; always asked last unless AI_PROVIDER=anthropic
AI_PROVIDER=gemini               # older setting: "anthropic" puts Claude first
ANTHROPIC_MODEL=claude-sonnet-5

# Phone notifications (Web Push). Optional: without these the server makes its own pair
# and keeps it in app_settings. To pin your own: python -m app.push keys (never commit it).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Pro alerts
TELEGRAM_BOT_TOKEN=
SMTP_HOST=smtp.gmail.com
# 465 uses SSL; 587 uses STARTTLS
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
# Email over HTTPS, for hosts that block mail ports (Railway does). Tried in this order: Brevo, Resend, then SMTP.
BREVO_API_KEY=
RESEND_API_KEY=
# Signs newsletter unsubscribe and confirm links; when empty, one is derived from SUPABASE_SERVICE_KEY
MAIL_TOKEN_SECRET=

# Frontend URL(s) allowed by CORS, comma-separated
FRONTEND_ORIGIN=http://localhost:5500
# Where public verdict links point
PUBLIC_SITE_URL=https://stratlab.studio
# The backend's own public address, for links in emails (unsubscribe, confirm). On Railway it defaults to the
# service's public domain (RAILWAY_PUBLIC_DOMAIN).
PUBLIC_API_URL=
# Google emails (comma-separated) that can open the /admin page in the app
ADMIN_EMAILS=
# Telegram chat ID that gets a message if the automatic Kite login fails
ADMIN_TELEGRAM_CHAT_ID=

# ---------- Research ----------
# US company pages (profile, fundamentals, earnings, insiders, news). Free key at finnhub.io, 60 calls a minute.
# India uses Screener.in, Yahoo Finance and Kite, and US/UK/EU/Japan/forex prices come from Yahoo: no keys needed.
FINNHUB_API_KEY=
RESEARCH_AI_PER_DAY=60           # fresh AI research reads per user per day (cached reads are free)

# ---------- Option chain recording (for options backtesting later) ----------
OPTION_SNAPSHOTS=NFO:NIFTY,NFO:BANKNIFTY,NFO:FINNIFTY,NFO:MIDCPNIFTY,BFO:SENSEX   # empty turns recording off
OPTION_SNAPSHOT_MINUTES=5
OPTION_SNAPSHOT_KEEP_DAYS=120

# ---------- Server ----------
SENTRY_DSN=                      # optional: send server errors to Sentry
SENTRY_ENV=production
POSTHOG_KEY=                     # optional: PostHog project key (phc_…) to count "payment completed" server-side
POSTHOG_HOST=https://us.i.posthog.com
BACKTEST_PROCESSES=2             # worker processes for backtests; 0 runs them in the server's process
HEAVY_SLOTS=2                    # heavy requests (backtests, scans, document reads) run at once
MARKET_DATABASE_URL=             # optional: a second Postgres for the bulky market-wide data (docs/ADMIN.md → Storage)
DB_LIMIT_MB=500                  # the main database's size limit, for the warning in Admin
