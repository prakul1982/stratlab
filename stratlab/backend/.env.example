# Copy to .env and fill in. Never commit the real .env.

# Supabase (Project settings > API). The service_role key must stay on the server.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# Zerodha Kite Connect
KITE_API_KEY=
KITE_API_SECRET=

# Razorpay (Test Mode keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BASIC=
RAZORPAY_PLAN_PRO=

# AI strategy writer: "gemini" (default) or "anthropic"
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Pro alerts
TELEGRAM_BOT_TOKEN=
SMTP_HOST=smtp.gmail.com
# 465 uses SSL; 587 uses STARTTLS
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=

# Frontend URL(s) allowed by CORS, comma-separated
FRONTEND_ORIGIN=http://localhost:5500
# Protects /admin/kite/login and /admin/status. Use a long random string.
ADMIN_KEY=
