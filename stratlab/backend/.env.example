# Copy to .env and fill in. Never commit the real .env.

# Supabase (Project settings > API). The service_role key must stay on the server.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# Zerodha Kite Connect
KITE_API_KEY=
KITE_API_SECRET=
# Optional automatic daily login (see README before enabling)
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=
KITE_AUTO_LOGIN_AT=08:00
# Restart the server after each Kite login so the live feed uses the new token
KITE_RESTART_AFTER_LOGIN=true

# Razorpay (Test Mode keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BASIC=
RAZORPAY_PLAN_PRO=

# AI strategy builder. Set one or more keys; providers are tried in order until one answers.
# All of these have free tiers. "auto" picks a suitable model from each provider's list.
AI_PROVIDERS=auto                # or an order like: groq,cerebras,gemini,openrouter,anthropic
GROQ_API_KEY=                    # console.groq.com: free, very fast
GROQ_MODEL=auto
CEREBRAS_API_KEY=                # cloud.cerebras.ai: free, very fast
CEREBRAS_MODEL=auto
GEMINI_API_KEY=                  # aistudio.google.com: free tier
GEMINI_MODEL=auto
OPENROUTER_API_KEY=              # openrouter.ai: "auto" uses only models marked :free
OPENROUTER_MODEL=auto
ANTHROPIC_API_KEY=               # paid; used last unless AI_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-5

# Pro alerts
TELEGRAM_BOT_TOKEN=
SMTP_HOST=smtp.gmail.com
# 465 uses SSL; 587 uses STARTTLS
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=

# Frontend URL(s) allowed by CORS, comma-separated
FRONTEND_ORIGIN=http://localhost:5500
# Protects /admin/kite/login and /admin/status. Use a long random string.
ADMIN_KEY=
# Google emails (comma-separated) that can open the /admin page in the app
ADMIN_EMAILS=
# Telegram chat ID that gets a message if the automatic Kite login fails
ADMIN_TELEGRAM_CHAT_ID=
