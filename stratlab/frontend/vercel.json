{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://checkout.razorpay.com https://*.razorpay.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://adservice.google.com https://*.adtrafficquality.google https://connect.facebook.net https://www.clarity.ms https://*.clarity.ms; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://stratlab-production-ca25.up.railway.app https://*.stratlab.studio https://*.supabase.co wss://*.supabase.co https://*.razorpay.com https://*.sentry.io https://us.i.posthog.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://adservice.google.com https://*.adtrafficquality.google https://connect.facebook.net https://www.facebook.com https://www.clarity.ms https://*.clarity.ms; frame-src https://*.razorpay.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://*.adtrafficquality.google; worker-src 'self'; manifest-src 'self'; form-action 'self' https://*.razorpay.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/(boot|theme).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?:index.html)?|(?:mine|all|features|trade|invest|money|notebooks|new|n|import|options|paper|plans|upgrade|help|account|settings|assistant|app|invite|admin|news|holdings|tax-report|alerts|research|chart|scans|watchlist|dev|login|signup|about|verdict|pricing|faq|terms|privacy|refunds|contact)(?:/.*)?)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/((?:mine|all|features|trade|invest|money|notebooks|new|n|import|options|paper|plans/.+|upgrade|help|account|settings|assistant|app|invite|admin|news|holdings|tax-report|alerts|research|chart|scans|watchlist|dev|login|signup|about|verdict|v|c)(?:/.*)?)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/stocks/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/blog/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/sitemaps/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/v/:token",
      "destination": "https://stratlab-production-ca25.up.railway.app/v/:token"
    },
    {
      "source": "/c/:token",
      "destination": "https://stratlab-production-ca25.up.railway.app/c/:token"
    },
    {
      "source": "/money/calendar/feed/:token",
      "destination": "https://stratlab-production-ca25.up.railway.app/money/calendar/feed/:token"
    },
    {
      "source": "/stocks/:path*",
      "destination": "https://stratlab-production-ca25.up.railway.app/stocks/:path*"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://stratlab-production-ca25.up.railway.app/blog/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://stratlab-production-ca25.up.railway.app/sitemap.xml"
    },
    {
      "source": "/sitemaps/:path*",
      "destination": "https://stratlab-production-ca25.up.railway.app/sitemaps/:path*"
    },
    {
      "source": "/unsubscribe",
      "destination": "https://stratlab-production-ca25.up.railway.app/unsubscribe"
    },
    {
      "source": "/email/confirm",
      "destination": "https://stratlab-production-ca25.up.railway.app/email/confirm"
    },
    {
      "source": "/news-link/:issue/:n",
      "destination": "https://stratlab-production-ca25.up.railway.app/news-link/:issue/:n"
    },
    {
      "source": "/((?:mine|all|features|trade|invest|money|notebooks|new|n|import|options|paper|plans|upgrade|help|account|settings|assistant|app|invite|admin|news|holdings|tax-report|alerts|research|chart|scans|watchlist|dev|login|signup|about|verdict)(?:/.*)?|pricing|faq|terms|privacy|refunds|contact)",
      "destination": "/index.html"
    }
  ]
}
