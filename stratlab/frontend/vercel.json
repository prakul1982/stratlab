{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "rewrites": [
    {
      "source": "/v/:token",
      "destination": "https://stratlab-production-ca25.up.railway.app/v/:token"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
